  <diagram name="C4 Fluxo Deploy + Estado OS" id="flow-oficina">
    <mxGraphModel dx="1818" dy="1070" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1000" math="0" shadow="0">
