{
  "name": "Oficina Mecânica — Recursos K8s",
  "description": "Métricas do cluster EKS via nri-bundle (CPU/memória nodes e pods)",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "K8s",
      "widgets": [
        {
          "title": "CPU usage por pod (cores)",
          "layout": { "column": 1, "row": 1, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "query": "SELECT average(cpuUsedCores) FROM K8sPodSample WHERE namespace='auto-repair-shop' FACET podName TIMESERIES SINCE 1 hour ago"
              }
            ]
          }
        },
        {
          "title": "Memory usage por pod (MB)",
          "layout": { "column": 7, "row": 1, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "query": "SELECT average(memoryUsedBytes)/1024/1024 AS 'MB' FROM K8sPodSample WHERE namespace='auto-repair-shop' FACET podName TIMESERIES SINCE 1 hour ago"
              }
            ]
          }
        },
        {
          "title": "CPU dos worker nodes (%)",
          "layout": { "column": 1, "row": 4, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "query": "SELECT average(cpuUsedCoresPercent) FROM K8sNodeSample FACET nodeName TIMESERIES SINCE 1 hour ago"
              }
            ]
          }
        },
        {
          "title": "Memory dos worker nodes (%)",
          "layout": { "column": 7, "row": 4, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "query": "SELECT average(memoryUsedBytes)/average(memoryCapacityBytes)*100 AS '%' FROM K8sNodeSample FACET nodeName TIMESERIES SINCE 1 hour ago"
              }
            ]
          }
        },
        {
          "title": "Réplicas atuais do deployment (HPA)",
          "layout": { "column": 1, "row": 7, "width": 12, "height": 3 },
          "visualization": { "id": "viz.area" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "query": "SELECT latest(numReplicas) FROM K8sDeploymentSample WHERE deploymentName='auto-repair-shop-api' TIMESERIES SINCE 6 hours ago"
              }
            ]
          }
        }
      ]
    }
  ]
}
