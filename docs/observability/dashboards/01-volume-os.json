{
  "name": "Oficina Mecânica — Volume de Ordens de Serviço",
  "description": "Volume diário de OS criadas, picos e tendência",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Volume",
      "widgets": [
        {
          "title": "OS criadas por dia (últimos 30 dias)",
          "layout": { "column": 1, "row": 1, "width": 8, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "query": "SELECT count(*) AS 'OS criadas' FROM ServiceOrderCreated TIMESERIES 1 day SINCE 30 days ago"
              }
            ]
          }
        },
        {
          "title": "Total no período",
          "layout": { "column": 9, "row": 1, "width": 4, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "query": "SELECT count(*) AS 'Total OS' FROM ServiceOrderCreated SINCE 30 days ago COMPARE WITH 30 days ago"
              }
            ]
          }
        },
        {
          "title": "OS por status atual (snapshot)",
          "layout": { "column": 1, "row": 4, "width": 6, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "query": "SELECT latest(toStatus) AS 'Status' FROM ServiceOrderStatusChanged FACET serviceOrderId SINCE 30 days ago LIMIT MAX"
              }
            ]
          }
        },
        {
          "title": "Top 10 clientes por volume de OS",
          "layout": { "column": 7, "row": 4, "width": 6, "height": 3 },
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "query": "SELECT count(*) FROM ServiceOrderCreated FACET customerId SINCE 30 days ago LIMIT 10"
              }
            ]
          }
        }
      ]
    }
  ]
}
