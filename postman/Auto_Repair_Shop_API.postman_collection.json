{
  "info": {
    "name": "Auto Repair Shop API - Fase 2",
    "description": "Collection completa para a API de oficina mecânica - Tech Challenge Fase 2 (14SOAT)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "customer_id", "value": "" },
    { "key": "vehicle_id", "value": "" },
    { "key": "service_id", "value": "" },
    { "key": "part_id", "value": "" },
    { "key": "order_id", "value": "" }
