              "mode": "raw",
              "raw": "{\n  \"customerDocument\": \"12345678901\",\n  \"customerName\": \"João da Silva\",\n  \"vehicle\": {\n    \"plate\": \"ABC1D23\",\n    \"make\": \"Toyota\",\n    \"model\": \"Corolla\",\n    \"year\": 2022\n  },\n  \"serviceIds\": [\n    { \"serviceId\": \"REPLACE_WITH_SERVICE_ID\", \"quantity\": 1 }\n  ],\n  \"partIds\": [\n    { \"partId\": \"REPLACE_WITH_PART_ID\", \"quantity\": 1 }\n  ]\n}"
