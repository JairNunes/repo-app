    {
      "name": "08. Fluxo Completo (Demo Video)",
      "description": "Execute na ordem: Login → Create OS → Start Diagnosis → Send for Approval → Approve → Finalize → Deliver. Use os IDs retornados em cada step.",
      "item": [
        {
          "name": "Step 1 - Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@oficina.com\",\n  \"password\": \"Oficina@2024\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Step 2 - List Services (pick IDs)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.length > 0) { pm.collectionVariables.set('service_id', json[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/admin/services", "host": ["{{base_url}}"], "path": ["admin", "services"] }
          }
        },
        {
          "name": "Step 3 - List Parts (pick IDs)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.length > 0) { pm.collectionVariables.set('part_id', json[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/admin/parts", "host": ["{{base_url}}"], "path": ["admin", "parts"] }
          }
        },
        {
          "name": "Step 4 - Create OS (Received)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('order_id', json.id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var serviceId = pm.collectionVariables.get('service_id');",
                  "var partId = pm.collectionVariables.get('part_id');",
                  "var body = {",
                  "  customerDocument: '12345678901',",
                  "  customerName: 'João da Silva',",
                  "  vehicle: { plate: 'TST1X99', make: 'Chevrolet', model: 'Onix', year: 2024 },",
                  "  serviceIds: [{ serviceId: serviceId, quantity: 1 }],",
                  "  partIds: [{ partId: partId, quantity: 2 }]",
                  "};",
                  "pm.variables.set('dynamic_body', JSON.stringify(body));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{dynamic_body}}"
            },
            "url": { "raw": "{{base_url}}/admin/service-orders", "host": ["{{base_url}}"], "path": ["admin", "service-orders"] }
          }
        },
        {
          "name": "Step 5 - Start Diagnosis",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/admin/service-orders/{{order_id}}/start-diagnosis", "host": ["{{base_url}}"], "path": ["admin", "service-orders", "{{order_id}}", "start-diagnosis"] }
          }
        },
        {
          "name": "Step 6 - Send for Approval",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/admin/service-orders/{{order_id}}/send-for-approval", "host": ["{{base_url}}"], "path": ["admin", "service-orders", "{{order_id}}", "send-for-approval"] }
          }
        },
        {
          "name": "Step 7a - Approve (via admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/admin/service-orders/{{order_id}}/approve", "host": ["{{base_url}}"], "path": ["admin", "service-orders", "{{order_id}}", "approve"] }
          }
        },
        {
          "name": "Step 7b - Approve (via external/public)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\",\n  \"source\": \"email\"\n}"
            },
            "url": { "raw": "{{base_url}}/service-orders/{{order_id}}/external-update", "host": ["{{base_url}}"], "path": ["service-orders", "{{order_id}}", "external-update"] }
          }
        },
        {
          "name": "Step 8 - Finalize",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/admin/service-orders/{{order_id}}/finalize", "host": ["{{base_url}}"], "path": ["admin", "service-orders", "{{order_id}}", "finalize"] }
          }
        },
        {
          "name": "Step 9 - Deliver",
          "request": {
            "method": "POST",
