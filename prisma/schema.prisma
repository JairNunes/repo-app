generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Customer {
  id           String         @id @default(uuid())
  name         String?
  document     String         @unique
  createdAt    DateTime       @default(now())
  vehicles     Vehicle[]
  serviceOrders ServiceOrder[]
}

model Vehicle {
  id           String         @id @default(uuid())
  customerId   String
  plate        String
  make         String
  model        String
  year         Int
  createdAt    DateTime       @default(now())
  customer     Customer       @relation(fields: [customerId], references: [id])
  serviceOrders ServiceOrder[]

  @@unique([customerId, plate])
}

model Service {
  id                  String                @id @default(uuid())
  name                String
  priceCents          Int
  createdAt           DateTime              @default(now())
  serviceOrderServices ServiceOrderService[]
}

model Part {
  id                String            @id @default(uuid())
  name              String
  priceCents        Int
  stockQuantity     Int
  createdAt         DateTime          @default(now())
  serviceOrderParts ServiceOrderPart[]
}

enum ServiceOrderStatus {
  Received
  InDiagnosis
  AwaitingApproval
  InExecution
  Finalized
  Delivered
}

model ServiceOrder {
  id                   String                @id @default(uuid())
  customerId           String
  vehicleId            String
  status               ServiceOrderStatus    @default(Received)
  totalCentsSnapshot   Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  diagnosisStartedAt   DateTime?
  executionStartedAt   DateTime?
  finalizedAt          DateTime?
  deliveredAt          DateTime?
  customer             Customer              @relation(fields: [customerId], references: [id])
  vehicle              Vehicle               @relation(fields: [vehicleId], references: [id])
  services             ServiceOrderService[]
  parts                ServiceOrderPart[]
}

model ServiceOrderService {
  id                      String       @id @default(uuid())
  serviceOrderId          String
  serviceId               String
  quantity                Int          @default(1)
  unitPriceCentsSnapshot  Int
  serviceOrder            ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  service                 Service      @relation(fields: [serviceId], references: [id])

  @@unique([serviceOrderId, serviceId])
}

model ServiceOrderPart {
  id                      String       @id @default(uuid())
  serviceOrderId          String
  partId                  String
  quantity                Int
  unitPriceCentsSnapshot  Int
  serviceOrder            ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  part                    Part         @relation(fields: [partId], references: [id])

  @@unique([serviceOrderId, partId])
}
